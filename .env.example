# Local dev needs nothing here — with DATABASE_URL unset, the app runs against an embedded,
# file-backed Postgres (PGlite) at data/maitrise-pg/, created automatically by `npm run seed`.
#
# For a real deployment (Vercel or anywhere else with no persistent local disk), provision a
# Postgres database and set this to its connection string:
#   - Vercel: Project → Storage → Create Database → Postgres (Neon-backed). Vercel then exposes
#     POSTGRES_URL / DATABASE_URL automatically as project env vars — no need to set it by hand.
#   - Neon / Supabase / any other Postgres host: paste the connection string it gives you.
#
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Time zone whose midnight starts a new day for streaks and the daily goal (IANA name).
# Defaults to UTC, which makes evening study in the Americas count as the next day.
# APP_TIME_ZONE=America/Vancouver
